# Copy to .env (which is gitignored) or export directly in your shell.
# The app reads ANTHROPIC_API_KEY from the environment and never stores it.
#
#   macOS / Linux : export ANTHROPIC_API_KEY="sk-ant-..."
#   Windows PS    : $env:ANTHROPIC_API_KEY="sk-ant-..."
#
# Do NOT commit your real key. Never commit a .env file.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
